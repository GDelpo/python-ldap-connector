# LDAP server connection
LDAP_URL=ldap://your-ldap-server.example.com:389

# Admin credentials used to bind for the initial lookup
LDAP_ADMIN_USERNAME=cn=admin,dc=example,dc=com
LDAP_ADMIN_PASSWORD=

# Search bases (DN) where users live — separar con "|" si hay más de uno
LDAP_SEARCH_BASES=ou=users,dc=example,dc=com|ou=staff,dc=example,dc=com
